# =============================
# Authentication (Auth0)
# =============================
NEXT_PUBLIC_AUTH_DOMAIN=your-auth-domain.com  # Auth0 domain
NEXT_PUBLIC_AUTH_CLIENT_ID=your-client-id  # Auth0 client ID
AUTH_SECRET=your-auth-secret  # Auth0 client secret

# =============================
# Storage Services (AWS S3)
# =============================
NEXT_PUBLIC_S3_BUCKET=your-s3-bucket  # AWS S3 bucket name
NEXT_PUBLIC_S3_REGION=your-s3-region  # AWS S3 region (e.g., us-east-1)
AWS_ACCESS_KEY_ID=your-aws-access-key  # AWS access key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key  # AWS secret access key

# =============================
# Database (Supabase)
# =============================
DATABASE_URL=your-supabase-database-url  # Supabase database connection string
SHADOW_DATABASE_URL=your-supabase-shadow-database-url  # Shadow database URL for migrations (optional)

# =============================
# Email Service (SendGrid)
# =============================
SMTP_HOST=smtp.sendgrid.net  # SendGrid SMTP host
SMTP_PORT=587  # SendGrid SMTP port (TLS)
SMTP_USER=apikey  # Use "apikey" for SendGrid SMTP authentication
SMTP_PASSWORD=your-sendgrid-api-key  # SendGrid API key

# =============================
# Payment Processing (Stripe)
# =============================
STRIPE_PUBLIC_KEY=your-stripe-public-key  # Stripe public API key
STRIPE_SECRET_KEY=your-stripe-secret-key  # Stripe secret API key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret  # Stripe webhook secret

# =============================
# Image Processing (Cloudinary)
# =============================
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name  # Cloudinary account name
CLOUDINARY_API_KEY=your-cloudinary-api-key  # Cloudinary API key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret  # Cloudinary API secret

# =============================
# Calendar Integration (Google Calendar API)
# =============================
GOOGLE_CALENDAR_CLIENT_ID=your-google-calendar-client-id  # Google Calendar OAuth Client ID
GOOGLE_CALENDAR_CLIENT_SECRET=your-google-calendar-client-secret  # Google Calendar OAuth Client Secret

# =============================
# API URLs
# =============================
NEXT_PUBLIC_API_URL=http://localhost:3000/api  # Local API base URL
NEXT_PUBLIC_WEBSITE_URL=http://localhost:3000  # Local website URL
